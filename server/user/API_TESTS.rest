Content-Type: application/json

{
  "type": "Package Enquiry",
  "fullName": "Alice Johnson",
  "emailAddress": "alice@example.com",
  "phoneNumber": "+91-9876543210",
  "packageId": "64abc123def456789abc1234",
  "numberOfTravelers": 4,
  "subject": "Group Booking for Goa",
  "message": "We are a group of 4 friends looking to book the Goa beach package for next month."
}

